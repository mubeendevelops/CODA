# Copy to .env and fill in real values. Never commit .env (see .gitignore).
ENV=dev
LOG_LEVEL=info

# --- Postgres ---
# Host path for the Postgres data directory (bind-mounted, not a named
# volume). Defaults to $HOME/.local/share/coda-dev/postgres-data. Override
# this if $HOME is not on a native Linux filesystem — Postgres refuses to
# start on a volume backed by a filesystem that can't report real Unix
# ownership (e.g. NTFS mounted via fuseblk/ntfs-3g).
# POSTGRES_DATA_DIR=/path/on/a/native/filesystem
POSTGRES_USER=coda
POSTGRES_PASSWORD=coda_dev_password
POSTGRES_DB=coda
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Host-side port for tooling that runs outside Docker (make migrate, make
# seed): docker-compose.yml publishes postgres on 5433, not 5432, to avoid
# clashing with a local Postgres install — see claude_context.md §11.
POSTGRES_HOST_PORT=5433

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
# Optional — defaults shown. Two logical databases on one server: DB holds
# the pipeline streams (stage.asr/nlp/results/progress/dlq), ASYNQ_DB holds
# Asynq's keyspace for go-orchestrator's periodic jobs. They must differ, so
# flushing one while debugging cannot wipe the other (config/redis.go
# refuses to start if they match).
# REDIS_DB=0
# REDIS_ASYNQ_DB=1
# REDIS_PASSWORD=

# --- MinIO ---
MINIO_ROOT_USER=coda_minio
MINIO_ROOT_PASSWORD=coda_minio_dev_password
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=coda
MINIO_USE_SSL=false

# --- Auth (dev only — rotate before anything but a laptop demo) ---
# Required, >= 16 bytes (go/internal/config/auth.go fails fast otherwise).
JWT_SIGNING_KEY=dev-only-change-me
# Optional — defaults shown, parsed with Go's time.ParseDuration.
# JWT_ACCESS_TOKEN_TTL=15m
# JWT_REFRESH_TOKEN_TTL=168h

# --- go-api HTTP layer (docs/architecture.md §7.6) — all optional, defaults shown ---
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# HTTP_REQUEST_TIMEOUT=30s
# RATE_LIMIT_REQUESTS=300
# RATE_LIMIT_WINDOW=1m
# AUTH_RATE_LIMIT_REQUESTS=20
# AUTH_RATE_LIMIT_WINDOW=1m

# --- External providers (claude_context.md §4, §10) ---
GROQ_API_KEY=
HF_TOKEN=

# --- Service ports (docs/architecture.md §1.1) ---
GO_API_HTTP_PORT=8080
GO_API_METRICS_PORT=9090
GO_ORCHESTRATOR_HEALTH_PORT=8081
ASR_GRPC_PORT=50051
ASR_HEALTH_PORT=8082
NLP_GRPC_PORT=50052
NLP_HEALTH_PORT=8083
