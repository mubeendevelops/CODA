# Secrets and local env
.env
*.pem
*.key

# Data — raw audio and anything derived from it never belongs in git.
# data/registry.yaml (the dataset-level summary — source/licence/N per
# dataset) IS tracked; the per-item *.manifest.jsonl files under
# data/registry/ and data/splits/ are not — they embed machine-local
# absolute paths and are cheaply regenerated (`make eval-registry` /
# `make eval-splits`).
data/raw/
data/splits/
data/processed/
data/registry/
*.wav
*.mp3
*.flac

# Go
go/bin/
go/*.out

# Python
python/**/__pycache__/
python/**/*.pyc
python/**/.pytest_cache/
python/**/.mypy_cache/
python/**/.ruff_cache/
python/.venv/
python/**/.venv/

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Docker / compose local overrides
docker-compose.override.yml

# Editors and OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Model caches / large downloads (Phase 2+)
.cache/
*.ckpt
*.safetensors

# Project planning docs (kept local, not tracked)
plan.md
Project_Blueprint.md
Project_Prompts.md
claude_context.md

# Claude Code local files
.claude/
CLAUDE.md
